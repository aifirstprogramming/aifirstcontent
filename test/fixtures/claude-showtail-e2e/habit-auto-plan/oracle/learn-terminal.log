{"type":"user","message":{"role":"user","content":[{"tool_use_id":"aifirst_replay_py-98-03.2_10","type":"tool_result","content":"1\timport contextlib\n2\timport io\n3\timport json\n4\timport os\n5\timport tempfile\n6\timport unittest\n7\t\n8\timport habit_tracker as ht\n9\t\n10\t\n11\tclass LoadSaveDataTests(unittest.TestCase):\n12\t    def test_load_missing_file_returns_empty_structure(self):\n13\t        with tempfile.TemporaryDirectory() as tmpdir:\n14\t            path = os.path.join(tmpdir, \"missing.json\")\n15\t            self.assertEqual(ht.load_data(path), {\"habits\": {}})\n16\t\n17\t    def test_load_invalid_json_returns_empty_structure(self):\n18\t        with tempfile.TemporaryDirectory() as tmpdir:\n19\t            path = os.path.join(tmpdir, \"bad.json\")\n20\t            with open(path, \"w\", encoding=\"utf-8\") as f:\n21\t                f.write(\"{not valid json\")\n22\t            self.assertEqual(ht.load_data(path), {\"habits\": {}})\n23\t\n24\t    def test_save_then_load_round_trip(self):\n25\t        with tempfile.TemporaryDirectory() as tmpdir:\n26\t            path = os.path.join(tmpdir, \"habits.json\")\n27\t            data = {\"habits\": {\"read\": {\"created\": \"2026-01-01\", \"completions\": []}}}\n28\t            ht.save_data(path, data)\n29\t            self.assertEqual(ht.load_data(path), data)\n30\t\n31\t    def test_save_writes_sorted_readable_json(self):\n32\t        with tempfile.TemporaryDirectory() as tmpdir:\n33\t            path = os.path.join(tmpdir, \"habits.json\")\n34\t            data = {\"habits\": {\"z\": {\"created\": \"2026-01-01\", \"completions\": []}}}\n35\t            ht.save_data(path, data)\n36\t            with open(path, \"r\", encoding=\"utf-8\") as f:\n37\t                raw = f.read()\n38\t            self.assertEqual(json.loads(raw), data)\n39\t            self.assertTrue(raw.endswith(\"\\n\"))\n40\t\n41\t\n42\tclass AddHabitTests(unittest.TestCase):\n43\t    def test_add_new_habit(self):\n44\t        data = {\"habits\": {}}\n45\t        ht.add_habit(data, \"exercise\", \"2026-08-30\")\n46\t        self.assertEqual(\n47\t            data[\"habits\"][\"exercise\"],\n48\t            {\"created\": \"2026-08-30\", \"completions\": []},\n49\t        )\n50\t\n51\t    def test_add_duplicate_habit_raises(self):\n52\t        data = {\"habits\": {}}\n53\t        ht.add_habit(data, \"exercise\", \"2026-08-30\")\n54\t        with self.assertRaises(ValueError):\n55\t            ht.add_habit(data, \"exercise\", \"2026-08-31\")\n56\t\n57\t\n58\tclass CompleteHabitTests(unittest.TestCase):\n59\t    def test_complete_unknown_habit_raises(self):\n60\t        data = {\"habits\": {}}\n61\t        with self.assertRaises(ValueError):\n62\t            ht.complete_habit(data, \"exercise\", \"2026-08-30\")\n63\t\n64\t    def test_complete_adds_date(self):\n65\t        data = {\"habits\": {}}\n66\t        ht.add_habit(data, \"exercise\", \"2026-08-01\")\n67\t        ht.complete_habit(data, \"exercise\", \"2026-08-30\")\n68\t        self.assertEqual(data[\"habits\"][\"exercise\"][\"completions\"], [\"2026-08-30\"])\n69\t\n70\t    def test_complete_is_idempotent_for_same_date(self):\n71\t        data = {\"habits\": {}}\n72\t        ht.add_habit(data, \"exercise\", \"2026-08-01\")\n73\t        ht.complete_habit(data, \"exercise\", \"2026-08-30\")\n74\t        ht.complete_habit(data, \"exercise\", \"2026-08-30\")\n75\t        self.assertEqual(data[\"habits\"][\"exercise\"][\"completions\"], [\"2026-08-30\"])\n76\t\n77\t    def test_complete_keeps_dates_sorted(self):\n78\t        data = {\"habits\": {}}\n79\t        ht.add_habit(data, \"exercise\", \"2026-08-01\")\n80\t        ht.complete_habit(data, \"exercise\", \"2026-08-30\")\n81\t        ht.complete_habit(data, \"exercise\", \"2026-08-15\")\n82\t        self.assertEqual(\n83\t            data[\"habits\"][\"exercise\"][\"completions\"],\n84\t            [\"2026-08-15\", \"2026-08-30\"],\n85\t        )\n86\t\n87\t\n88\tclass ListHabitsTests(unittest.TestCase):\n89\t    def test_list_empty(self):\n90\t        self.assertEqual(ht.list_habits({\"habits\": {}}, \"2026-08-30\"), [])\n91\t\n92\t    def test_list_sorted_by_name_with_summary(self):\n93\t        data = {\"habits\": {}}\n94\t        ht.add_habit(data, \"read\", \"2026-08-01\", weekly_goal=7)\n95\t        ht.add_habit(data, \"exercise\", \"2026-08-02\", weekly_goal=3)\n96\t        ht.complete_habit(data, \"exercise\", \"2026-08-10\")\n97\t        ht.complete_habit(data, \"exercise\", \"2026-08-05\")\n98\t        rows = ht.list_habits(data, \"2026-08-10\")\n99\t        self.assertEqual(\n100\t            rows,\n101\t            [\n102\t                (\"exercise\", \"2026-08-02\", 2, \"2026-08-10\", 3, 1),\n103\t                (\"read\", \"2026-08-01\", 0, \"-\", 7, 0),\n104\t            ],\n105\t        )\n106\t\n107\t    def test_list_defaults_as_of_date_to_today(self):\n108\t        data = {\"habits\": {}}\n109\t        ht.add_habit(data, \"exercise\", \"2026-08-01\")\n110\t        rows = ht.list_habits(data)\n111\t        self.assertEqual(rows[0][0], \"exercise\")\n112\t\n113\t\n114\tclass FormatHabitListTests(unittest.TestCase):\n115\t    def test_format_empty(self):\n116\t        self.assertEqual(ht.format_habit_list([]), \"No habits tracked yet.\")\n117\t\n118\t    def test_format_includes_header_and_rows(self):\n119\t        rows = [(\"exercise\", \"2026-08-02\", 2, \"2026-08-10\", 3, 1)]\n120\t        output = ht.format_habit_list(rows)\n121\t        self.assertIn(\"NAME\", output)\n122\t        self.assertIn(\"GOAL\", output)\n123\t        self.assertIn(\"STREAK\", output)\n124\t        self.assertIn(\"exercise\", output)\n125\t        self.assertIn(\"2026-08-10\", output)\n126\t\n127\t\n128\tclass WeekBoundsTests(unittest.TestCase):\n129\t    def test_monday_as_of(self):\n130\t        self.assertEqual(ht.week_bounds(\"2026-08-24\"), (\"2026-08-24\", \"2026-08-30\"))\n131\t\n132\t    def test_sunday_as_of(self):\n133\t        self.assertEqual(ht.week_bounds(\"2026-08-30\"), (\"2026-08-24\", \"2026-08-30\"))\n134\t\n135\t    def test_midweek_as_of(self):\n136\t        self.assertEqual(ht.week_bounds(\"2026-08-27\"), (\"2026-08-24\", \"2026-08-30\"))\n137\t\n138\t\n139\tclass CompletionsInRangeTests(unittest.TestCase):\n140\t    def test_counts_inclusive_range(self):\n141\t        completions = [\"2026-08-24\", \"2026-08-27\", \"2026-08-30\", \"2026-08-31\"]\n142\t        self.assertEqual(\n143\t            ht.completions_in_range(completions, \"2026-08-24\", \"2026-08-30\"), 3\n144\t        )\n145\t\n146\t    def test_empty_completions(self):\n147\t        self.assertEqual(ht.completions_in_range([], \"2026-08-24\", \"2026-08-30\"), 0)\n148\t\n149\t\n150\tclass StreakTests(unittest.TestCase):\n151\t    def test_empty_completions_has_no_streak(self):\n152\t        self.assertEqual(ht.current_streak([], \"2026-08-30\"), 0)\n153\t\n154\t    def test_streak_ending_today(self):\n155\t        completions = [\"2026-08-28\", \"2026-08-29\", \"2026-08-30\"]\n156\t        self.assertEqual(ht.current_streak(completions, \"2026-08-30\"), 3)\n157\t\n158\t    def test_streak_alive_when_yesterday_completed(self):\n159\t        completions = [\"2026-08-28\", \"2026-08-29\"]\n160\t        self.assertEqual(ht.current_streak(completions, \"2026-08-30\"), 2)\n161\t\n162\t    def test_streak_broken_by_gap(self):\n163\t        completions = [\"2026-08-20\", \"2026-08-28\"]\n164\t        self.assertEqual(ht.current_streak(completions, \"2026-08-30\"), 0)\n165\t\n166\t    def test_longest_streak_across_multiple_runs(self):\n167\t        completions = [\n168\t            \"2026-08-01\",\n169\t            \"2026-08-02\",\n170\t            \"2026-08-10\",\n171\t            \"2026-08-11\",\n172\t            \"2026-08-12\",\n173\t            \"2026-08-13\",\n174\t            \"2026-08-30\",\n175\t        ]\n176\t        self.assertEqual(ht.longest_streak(completions), 4)\n177\t\n178\t    def test_longest_streak_empty(self):\