{"type":"user","message":{"role":"user","content":[{"tool_use_id":"aifirst_preplan_py-98-03.2_0","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Deterministic standard-library habit tracker CLI backed by a JSON file.\"\"\"\n3\t\n4\timport argparse\n5\timport datetime\n6\timport json\n7\timport os\n8\timport sys\n9\t\n10\tDEFAULT_DATA_FILE = \"habits.json\"\n11\t\n12\t\n13\tdef today_str():\n14\t    return datetime.date.today().isoformat()\n15\t\n16\t\n17\tdef load_data(path):\n18\t    if not os.path.exists(path):\n19\t        return {\"habits\": {}}\n20\t    with open(path, \"r\", encoding=\"utf-8\") as f:\n21\t        try:\n22\t            data = json.load(f)\n23\t        except json.JSONDecodeError:\n24\t            return {\"habits\": {}}\n25\t    if \"habits\" not in data:\n26\t        data[\"habits\"] = {}\n27\t    return data\n28\t\n29\t\n30\tdef save_data(path, data):\n31\t    with open(path, \"w\", encoding=\"utf-8\") as f:\n32\t        json.dump(data, f, indent=2, sort_keys=True)\n33\t        f.write(\"\\n\")\n34\t\n35\t\n36\tdef add_habit(data, name, date):\n37\t    if name in data[\"habits\"]:\n38\t        raise ValueError(f\"habit {name!r} already exists\")\n39\t    data[\"habits\"][name] = {\"created\": date, \"completions\": []}\n40\t\n41\t\n42\tdef complete_habit(data, name, date):\n43\t    if name not in data[\"habits\"]:\n44\t        raise ValueError(f\"habit {name!r} does not exist\")\n45\t    completions = data[\"habits\"][name][\"completions\"]\n46\t    if date not in completions:\n47\t        completions.append(date)\n48\t        completions.sort()\n49\t\n50\t\n51\tdef list_habits(data):\n52\t    \"\"\"Return a deterministically ordered list of (name, created, count, last) tuples.\"\"\"\n53\t    result = []\n54\t    for name in sorted(data[\"habits\"]):\n55\t        habit = data[\"habits\"][name]\n56\t        completions = habit[\"completions\"]\n57\t        last = completions[-1] if completions else \"-\"\n58\t        result.append((name, habit[\"created\"], len(completions), last))\n59\t    return result\n60\t\n61\t\n62\tdef format_habit_list(rows):\n63\t    if not rows:\n64\t        return \"No habits tracked yet.\"\n65\t    lines = [f\"{'NAME':<20}{'CREATED':<12}{'COMPLETIONS':<13}{'LAST':<12}\"]\n66\t    for name, created, count, last in rows:\n67\t        lines.append(f\"{name:<20}{created:<12}{count:<13}{last:<12}\")\n68\t    return \"\\n\".join(lines)\n69\t\n70\t\n71\tdef build_parser():\n72\t    parser = argparse.ArgumentParser(prog=\"habit_tracker\", description=__doc__)\n73\t    parser.add_argument(\n74\t        \"--file\", default=DEFAULT_DATA_FILE, help=\"path to the JSON data file\"\n75\t    )\n76\t    subparsers = parser.add_subparsers(dest=\"command\", required=True)\n77\t\n78\t    add_parser = subparsers.add_parser(\"add\", help=\"add a new habit\")\n79\t    add_parser.add_argument(\"name\", help=\"name of the habit\")\n80\t    add_parser.add_argument(\n81\t        \"--date\", default=None, help=\"creation date (YYYY-MM-DD), defaults to today\"\n82\t    )\n83\t\n84\t    subparsers.add_parser(\"list\", help=\"list all habits\")\n85\t\n86\t    complete_parser = subparsers.add_parser(\"complete\", help=\"mark a habit complete\")\n87\t    complete_parser.add_argument(\"name\", help=\"name of the habit\")\n88\t    complete_parser.add_argument(\n89\t        \"--date\", default=None, help=\"completion date (YYYY-MM-DD), defaults to today\"\n90\t    )\n91\t\n92\t    return parser\n93\t\n94\t\n95\tdef main(argv=None):\n96\t    parser = build_parser()\n97\t    args = parser.parse_args(argv)\n98\t    data = load_data(args.file)\n99\t\n100\t    if args.command == \"add\":\n101\t        date = args.date or today_str()\n102\t        try:\n103\t            add_habit(data, args.name, date)\n104\t        except ValueError as exc:\n105\t            print(f\"Error: {exc}\", file=sys.stderr)\n106\t            return 1\n107\t        save_data(args.file, data)\n108\t        print(f\"Added habit {args.name!r} (created {date}).\")\n109\t        return 0\n110\t\n111\t    if args.command == \"list\":\n112\t        print(format_habit_list(list_habits(data)))\n113\t        return 0\n114\t\n115\t    if args.command == \"complete\":\n116\t        date = args.date or today_str()\n117\t        try:\n118\t            complete_habit(data, args.name, date)\n119\t        except ValueError as exc:\n120\t            print(f\"Error: {exc}\", file=sys.stderr)\n121\t            return 1\n122\t        save_data(args.file, data)\n123\t        print(f\"Completed habit {args.name!r} for {date}.\")\n124\t        return 0\n125\t\n126\t    parser.error(\"unknown command\")\n127\t    return 2\n128\t\n129\t\n130\tif __name__ == \"__main__\":\n131\t    sys.exit(main())\n132\t"}]},"parent_tool_use_id":null,"session_id":"06705e58-4aa4-44bb-8ecf-b9169a15dfce","uuid":"ab5ea945-489d-40bc-880d-5c35cc0aab3d","timestamp":"2026-08-30T22:17:59.563Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/aifirst-habit-auto-plan-capture-61kDLD/replay5/habit_tracker.py","content":"#!/usr/bin/env python3\n\"\"\"Deterministic standard-library habit tracker CLI backed by a JSON file.\"\"\"\n\nimport argparse\nimport datetime\nimport json\nimport os\nimport sys\n\nDEFAULT_DATA_FILE = \"habits.json\"\n\n\ndef today_str():\n    return datetime.date.today().isoformat()\n\n\ndef load_data(path):\n    if not os.path.exists(path):\n        return {\"habits\": {}}\n    with open(path, \"r\", encoding=\"utf-8\") as f:\n        try:\n            data = json.load(f)\n        except json.JSONDecodeError:\n            return {\"habits\": {}}\n    if \"habits\" not in data:\n        data[\"habits\"] = {}\n    return data\n\n\ndef save_data(path, data):\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(data, f, indent=2, sort_keys=True)\n        f.write(\"\\n\")\n\n\ndef add_habit(data, name, date):\n    if name in data[\"habits\"]:\n        raise ValueError(f\"habit {name!r} already exists\")\n    data[\"habits\"][name] = {\"created\": date, \"completions\": []}\n\n\ndef complete_habit(data, name, date):\n    if name not in data[\"habits\"]:\n        raise ValueError(f\"habit {name!r} does not exist\")\n    completions = data[\"habits\"][name][\"completions\"]\n    if date not in completions:\n        completions.append(date)\n        completions.sort()\n\n\ndef list_habits(data):\n    \"\"\"Return a deterministically ordered list of (name, created, count, last) tuples.\"\"\"\n    result = []\n    for name in sorted(data[\"habits\"]):\n        habit = data[\"habits\"][name]\n        completions = habit[\"completions\"]\n        last = completions[-1] if completions else \"-\"\n        result.append((name, habit[\"created\"], len(completions), last))\n    return result\n\n\ndef format_habit_list(rows):\n    if not rows:\n        return \"No habits tracked yet.\"\n    lines = [f\"{'NAME':<20}{'CREATED':<12}{'COMPLETIONS':<13}{'LAST':<12}\"]\n    for name, created, count, last in rows:\n        lines.append(f\"{name:<20}{created:<12}{count:<13}{last:<12}\")\n    return \"\\n\".join(lines)\n\n\ndef build_parser():\n    parser = argparse.ArgumentParser(prog=\"habit_tracker\", description=__doc__)\n    parser.add_argument(\n        \"--file\", default=DEFAULT_DATA_FILE, help=\"path to the JSON data file\"\n    )\n    subparsers = parser.add_subparsers(dest=\"command\", required=True)\n\n    add_parser = subparsers.add_parser(\"add\", help=\"add a new habit\")\n    add_parser.add_argument(\"name\", help=\"name of the habit\")\n    add_parser.add_argument(\n        \"--date\", default=None, help=\"creation date (YYYY-MM-DD), defaults to today\"\n    )\n\n    subparsers.add_parser(\"list\", help=\"list all habits\")\n\n    complete_parser = subparsers.add_parser(\"complete\", help=\"mark a habit complete\")\n    complete_parser.add_argument(\"name\", help=\"name of the habit\")\n    complete_parser.add_argument(\n        \"--date\", default=None, help=\"completion date (YYYY-MM-DD), defaults to today\"\n    )\n\n    return parser\n\n\ndef main(argv=None):\n    parser = build_parser()\n    args = parser.parse_args(argv)\n    data = load_data(args.file)\n\n    if args.command == \"add\":\n        date = args.date or today_str()\n        try:\n            add_habit(data, args.name, date)\n        except ValueError as exc:\n            print(f\"Error: {exc}\", file=sys.stderr)\n            return 1\n        save_data(args.file, data)\n        print(f\"Added habit {args.name!r} (created {date}).\")\n        return 0\n\n    if args.command == \"list\":\n        print(format_habit_list(list_habits(data)))\n        return 0\n\n    if args.command == \"complete\":\n        date = args.date or today_str()\n        try:\n            complete_habit(data, args.name, date)\n        except ValueError as exc:\n            print(f\"Error: {exc}\", file=sys.stderr)\n            return 1\n        save_data(args.file, data)\n        print(f\"Completed habit {args.name!r} for {date}.\")\n        return 0\n\n    parser.error(\"unknown command\")\n    return 2\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":132,"startLine":1,"totalLines":132}}}
